<?xml version="1.0" encoding="utf-8"?>
<android.car.app.radio.SubFreqLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageButton
        android:id="@+id/freqButton"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/mod_preset_bg"/>
    <LinearLayout
        android:id="@+id/freqShow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/mod_preset_pad"
        android:paddingRight="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/indexText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/mod_preset_index_ts"
                android:textColor="@color/mod_text3"
                android:text="@string/radio_nt_p1"/>
            <ImageView
                android:tag="mod_preset_logo"
                android:layout_width="@dimen/mod_preset_logo"
                android:layout_height="@dimen/mod_preset_logo"
                android:scaleType="fitCenter"
                android:visibility="gone"/>
        </LinearLayout>
        <TextView
            android:id="@+id/freqName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/mod_preset_name_ts"
            android:textStyle="bold"
            android:textColor="@color/mod_text"
            android:textColorHint="@color/mod_text3"
            android:hint="@string/mod_no_name"
            android:singleLine="true"
            android:ellipsize="end"/>
        <android.car.ui.AutoScrollTextView
            android:id="@+id/freqText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/mod_preset_freq_ts"
            android:textColor="@color/mod_text2"
            android:singleLine="true"/>
        <TextView
            android:id="@+id/hzText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/freqText2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"/>
    </LinearLayout>
</android.car.app.radio.SubFreqLayout>
