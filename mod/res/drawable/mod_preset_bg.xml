<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/mod_card_pressed"/><stroke android:width="1dp" android:color="@color/mod_stroke"/><corners android:radius="14dp"/></shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle"><solid android:color="@color/mod_accent_dim"/><stroke android:width="2dp" android:color="@color/mod_accent"/><corners android:radius="14dp"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/mod_card"/><stroke android:width="1dp" android:color="@color/mod_stroke"/><corners android:radius="14dp"/></shape>
    </item>
</selector>
