<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutBg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mod_bg">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:id="@+id/btn_fm"
            android:layout_width="104dp"
            android:layout_height="42dp"
            android:layout_marginRight="8dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/mod_pill">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                android:textSize="19sp" android:textStyle="bold" android:textColor="@color/mod_pill_text" android:text="FM"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/btn_am"
            android:layout_width="104dp"
            android:layout_height="42dp"
            android:layout_marginRight="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/mod_pill">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                android:textSize="19sp" android:textStyle="bold" android:textColor="@color/mod_pill_text" android:text="AM"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/mod_stations_btn"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginRight="8dp"
            android:minWidth="104dp"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:onClick="modOpenStations"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/mod_pill">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                android:textSize="19sp" android:textStyle="bold" android:textColor="@color/mod_pill_text" android:text="@string/mod_stations"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/ll_collect_list"
            android:layout_width="104dp"
            android:layout_height="42dp"
            android:layout_marginRight="8dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/mod_pill">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                android:textSize="19sp" android:textStyle="bold" android:textColor="@color/mod_pill_text" android:text="@string/mod_list"/>
        </FrameLayout>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <android.car.ui.ShadowTextView
            android:id="@+id/flag_seek_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textSize="12sp"
            android:textColor="@color/mod_text2"
            android:text=""/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone">
        <android.car.ui.ShadowTextView
            android:id="@+id/flag_st"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textSize="12sp"
            android:textColor="@color/mod_text2"
            android:text="@string/radio_nt_st"/>
        <ImageView
            android:id="@+id/flag_circle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_voice_small"/>
        <android.car.ui.ShadowTextView
            android:id="@+id/flag_loc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textSize="12sp"
            android:textColor="@color/mod_text2"
            android:text="@string/radio_nt_loc"/>
        <LinearLayout
            android:id="@+id/rds_flag_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        <android.car.ui.ShadowTextView
            android:id="@+id/rds_flag_tp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/mod_chip"
            android:textSize="12sp"
            android:textColor="@color/mod_text2"
            android:text="@string/radio_nt_tp"/>
        <android.car.ui.ShadowTextView
            android:id="@+id/rds_flag_ta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/mod_chip"
            android:textSize="12sp"
            android:textColor="@color/mod_text2"
            android:text="@string/radio_nt_ta"/>
        <android.car.ui.ShadowTextView
            android:id="@+id/rds_flag_af"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/mod_chip"
            android:textSize="12sp"
            android:textColor="@color/mod_text2"
            android:text="@string/radio_nt_af"/>
        <android.car.ui.ShadowTextView
            android:id="@+id/rds_flag_pty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/mod_chip"
            android:textSize="12sp"
            android:textColor="@color/mod_text2"
            android:text="@string/radio_nt_pty"/>
        </LinearLayout>
        </LinearLayout>
        <TextView
            android:tag="mod_ind_st"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="6dp"
            android:minWidth="24dp"
            android:gravity="center"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:background="@drawable/mod_ind_bg"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/mod_ind_text"
            android:text="@string/radio_nt_st"/>
        <ImageView
            android:tag="mod_ind_ring"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="6dp"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:background="@drawable/mod_ind_bg"
            android:src="@drawable/icon_voice_small"
            android:tint="@color/mod_ind_text"/>
        <TextView
            android:tag="mod_ind_loc"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="6dp"
            android:minWidth="24dp"
            android:gravity="center"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:background="@drawable/mod_ind_bg"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/mod_ind_text"
            android:text="@string/radio_nt_loc"/>
        <TextView
            android:tag="mod_ind_tp"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="6dp"
            android:minWidth="24dp"
            android:gravity="center"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:background="@drawable/mod_ind_bg"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/mod_ind_text"
            android:text="@string/radio_nt_tp"/>
        <TextView
            android:tag="mod_ind_ta"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="6dp"
            android:minWidth="24dp"
            android:gravity="center"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:background="@drawable/mod_ind_bg"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/mod_ind_text"
            android:text="@string/radio_nt_ta"/>
        <TextView
            android:tag="mod_ind_af"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="6dp"
            android:minWidth="24dp"
            android:gravity="center"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:background="@drawable/mod_ind_bg"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/mod_ind_text"
            android:text="@string/radio_nt_af"/>
        <TextView
            android:tag="mod_ind_pty"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="6dp"
            android:minWidth="24dp"
            android:gravity="center"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:background="@drawable/mod_ind_bg"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/mod_ind_text"
            android:text="@string/radio_nt_pty"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <ImageButton
                android:id="@+id/btn_prev"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/mod_circle_btn"
                android:src="@drawable/mod_ic_prev"
                android:scaleType="center"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="1dp"
                android:textSize="13sp"
                android:textColor="@color/mod_text2"
                android:text="@string/mod_prev"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <android.car.ui.ShadowTextView
                android:id="@+id/rds_ps_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/mod_text2"
                android:singleLine="true"
                android:text=""/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">
                <ImageView
                    android:tag="mod_main_logo"
                    android:layout_width="58sp"
                    android:layout_height="58sp"
                    android:layout_marginRight="14dp"
                    android:layout_marginBottom="4dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/imgBandType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="9dp"
                    android:textSize="15sp"
                    android:textColor="@color/mod_text3"
                    android:text="FM1"/>
                <FrameLayout
                    android:id="@+id/mainFreq_framelayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <android.car.app.radio.ImageNumberView
                        android:id="@+id/mainFreq"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="invisible"/>
                    <TextView
                        android:id="@+id/mainFreq_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textSize="58sp"
                        android:textColor="@color/mod_text"/>
                </FrameLayout>
                <TextView
                    android:id="@+id/imgBandUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginBottom="9dp"
                    android:textSize="18sp"
                    android:textColor="@color/mod_text2"
                    android:text="MHz"/>
            </LinearLayout>
            <android.car.ui.AutoScrollTextView
                android:id="@+id/radio_main_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:textSize="13sp"
                android:textColor="@color/mod_text3"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <android.car.ui.ShadowTextView
                    android:id="@+id/rds_pty_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/mod_text3"
                    android:text=""/>
                <android.car.ui.ShadowTextView
                    android:id="@+id/rds_pty_sel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:visibility="gone"
                    android:textSize="12sp"
                    android:textColor="@color/mod_accent"
                    android:text=""/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">
                <SeekBar
                    android:id="@+id/freq_bar"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:focusable="false"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/mod_track"
                    android:thumb="@drawable/mod_thumb"/>
                <ImageView
                    android:id="@+id/freqrule_bg"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/fm_8750_1080"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/mod_circle_btn"
                android:src="@drawable/mod_ic_next"
                android:scaleType="center"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="1dp"
                android:textSize="13sp"
                android:textColor="@color/mod_text2"
                android:text="@string/mod_next"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="4dp"
        android:layout_marginLeft="-4dp"
        android:layout_marginRight="-4dp"
        android:orientation="horizontal">
        <include
            android:id="@+id/subFreq1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            layout="@layout/mod_subfreq"/>
        <include
            android:id="@+id/subFreq2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            layout="@layout/mod_subfreq"/>
        <include
            android:id="@+id/subFreq3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            layout="@layout/mod_subfreq"/>
        <include
            android:id="@+id/subFreq4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            layout="@layout/mod_subfreq"/>
        <include
            android:id="@+id/subFreq5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            layout="@layout/mod_subfreq"/>
        <include
            android:id="@+id/subFreq6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            layout="@layout/mod_subfreq"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/mod_stroke"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/btn_aps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/mod_item_bg">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true"
                android:src="@drawable/mod_ic_aps"
                android:tint="@color/mod_icon_tint"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:singleLine="true"
                android:textSize="12sp"
                android:textColor="@color/mod_label_color"
                android:text="@string/mod_aps"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_st"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/mod_item_bg">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true"
                android:src="@drawable/mod_ic_st"
                android:tint="@color/mod_icon_tint"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:singleLine="true"
                android:textSize="12sp"
                android:textColor="@color/mod_label_color"
                android:text="@string/mod_st"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_loc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/mod_item_bg">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true"
                android:src="@drawable/mod_ic_loc"
                android:tint="@color/mod_icon_tint"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:singleLine="true"
                android:textSize="12sp"
                android:textColor="@color/mod_label_color"
                android:text="@string/mod_loc"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rds_btn_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/btn_ta"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/mod_item_bg">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true"
                android:src="@drawable/mod_ic_ta"
                android:tint="@color/mod_icon_tint"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:singleLine="true"
                android:textSize="12sp"
                android:textColor="@color/mod_label_color"
                android:text="@string/mod_ta"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_af"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/mod_item_bg">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true"
                android:src="@drawable/mod_ic_af"
                android:tint="@color/mod_icon_tint"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:singleLine="true"
                android:textSize="12sp"
                android:textColor="@color/mod_label_color"
                android:text="@string/mod_af"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_pty"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/mod_item_bg">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true"
                android:src="@drawable/mod_ic_pty"
                android:tint="@color/mod_icon_tint"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:singleLine="true"
                android:textSize="12sp"
                android:textColor="@color/mod_label_color"
                android:text="@string/mod_pty"/>
        </LinearLayout>
            <ImageButton
                android:id="@+id/btn_pty_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
